<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="340.0" prefWidth="380.0"
            stylesheets="@Styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.nanosip.nanosip.Controllers.Modals.CrClientesController"
            styleClass="root-pane">

    <!-- TOP BAR -->
    <top>
        <HBox fx:id="topbar" alignment="CENTER_LEFT" prefHeight="46.0" spacing="8" styleClass="topbar">
            <padding><Insets bottom="8" left="16" right="8" top="8"/></padding>
            <Label fx:id="lblTitulo" styleClass="topbar-title" text="Nuevo Cliente"/>
            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#cerrarModal" styleClass="window-btn">

                <graphic>
                    <ImageView fitHeight="14" fitWidth="14" preserveRatio="true">
                        <image>
                            <Image url="@images/close.png" />
                        </image>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- FORMULARIO -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="14" styleClass="login-card">
            <padding><Insets bottom="28" left="32" right="32" top="24"/></padding>

            <!-- ID (solo lectura) -->
            <VBox spacing="4">
                <Label styleClass="form-label" text="ID"/>
                <TextField fx:id="txtId" promptText="Asignado automáticamente"
                           styleClass="login-field" editable="false" opacity="0.6"/>
            </VBox>

            <!-- Nombre -->
            <VBox spacing="4">
                <Label styleClass="form-label" text="Nombre"/>
                <TextField fx:id="txtNombre" promptText="Nombre del cliente"
                           styleClass="login-field"/>
            </VBox>

            <!-- RFC -->
            <VBox spacing="4">
                <Label styleClass="form-label" text="RFC"/>
                <TextField fx:id="txtRFC" promptText="RFC"
                           styleClass="login-field"/>
            </VBox>

            <!-- Teléfono -->
            <VBox spacing="4">
                <Label styleClass="form-label" text="Teléfono"/>
                <TextField fx:id="txtTelefono" promptText="Teléfono"
                           styleClass="login-field"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Botón guardar -->
            <Button fx:id="btnGuardar" onAction="#guardar"
                    text="Guardar" styleClass="login-btn"
                    maxWidth="Infinity"/>
        </VBox>
    </center>

</BorderPane>

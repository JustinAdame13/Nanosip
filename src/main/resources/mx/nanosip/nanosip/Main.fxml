<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="82.0" prefWidth="606.0" styleClass="root-pane" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.nanosip.nanosip.Controllers.MainController">

   <center>
      <HBox alignment="TOP_CENTER" prefHeight="34.0" prefWidth="606.0" spacing="10" styleClass="Main-bar">
         <children>
            <Button fx:id="dockSesion" onAction="#cerrarSesion" styleClass="dockbtn" text="🔒 Sesión" />
            <Button fx:id="dockEmpleados" onAction="#irEmpleados" styleClass="dockbtn" text="👤 Empleados" />
            <Button fx:id="dockVentas" onAction="#irVentas" styleClass="dockbtn" text="💰 Ventas" />
            <Button fx:id="dockClientes" onAction="#irClientes" styleClass="dockbtn" text="🏢 Clientes" />
            <Button fx:id="dockProductos" onAction="#irProductos" styleClass="dockbtn" text="📦 Productos" />
            <Button fx:id="dockProveed" onAction="#irProveedores" styleClass="dockbtn" text="🚚 Proveed." />
         </children>
         <padding>
            <Insets top="10.0" />
         </padding>
      </HBox>
   </center>
   <top>
      <HBox fx:id="topbar" alignment="CENTER_RIGHT" prefHeight="26.0" prefWidth="473.0" styleClass="topbar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnMinimizar" onAction="#minimizar" styleClass="wmbtn, wmbtn-min" text="─" />
            <Button fx:id="btnCerrar" onAction="#cerrar" styleClass="wmbtn, wmbtn-close" text="✕" />
         </children></HBox>
   </top>

</BorderPane>

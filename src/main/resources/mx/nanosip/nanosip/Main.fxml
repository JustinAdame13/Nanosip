<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<VBox fx:id="topbar" prefHeight="85.0" prefWidth="650.0" styleClass="root-pane, menubar" stylesheets="@Styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.nanosip.nanosip.Controllers.MainController">

   <!-- Controles de ventana (Minimizar / Cerrar) -->
   <HBox alignment="CENTER_RIGHT" spacing="8">
      <padding><Insets right="12" top="8"/></padding>
      <Button fx:id="btnMinimizar" mnemonicParsing="false" onAction="#minimizar" styleClass="window-btn">

         <graphic>
            <ImageView fitHeight="14" fitWidth="14" preserveRatio="true">
               <image>
                  <Image url="@images/minimize.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
      <Button fx:id="btnCerrar" mnemonicParsing="false" onAction="#cerrar" styleClass="window-btn">

         <graphic>
            <ImageView fitHeight="14" fitWidth="14" preserveRatio="true">
               <image>
                  <Image url="@images/close.png" />
               </image>
            </ImageView>
         </graphic>
      </Button>
   </HBox>

   <!-- Botones de los Módulos -->
   <HBox alignment="CENTER" spacing="12">
      <padding><Insets bottom="15" top="5"/></padding>
      <Button fx:id="dockSesion" onAction="#cerrarSesion" styleClass="dockbtn" text="🔒 Sesión" />
      <Button fx:id="dockEmpleados" onAction="#irEmpleados" styleClass="dockbtn" text="👤 Empleados" />
      <Button fx:id="dockVentas" onAction="#irVentas" styleClass="dockbtn" text="💰 Ventas" />
      <Button fx:id="dockClientes" onAction="#irClientes" styleClass="dockbtn" text="🏢 Clientes" />
      <Button fx:id="dockProductos" onAction="#irProductos" styleClass="dockbtn" text="📦 Productos" />
      <Button fx:id="dockProveed" onAction="#irProveedores" styleClass="dockbtn" text="🚚 Proveed." />
   </HBox>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.nanosip.nanosip.Controllers.MainController" stylesheets="@Styles.css" styleClass="root-pane">

   <center>
      <HBox alignment="CENTER" prefHeight="44.0" prefWidth="473.0" spacing="10" styleClass="Main-bar">
         <children>
            <Button fx:id="dockSesion" onAction="#cerrarSesion" styleClass="dockbtn" text="🔒 Sesión" />
            <Button fx:id="dockEmpleados" onAction="#irEmpleados" styleClass="dockbtn, dockbtn-active" text="👤 Empleados" />
            <Button fx:id="dockVentas" onAction="#irVentas" styleClass="dockbtn" text="💰 Ventas" />
            <Button fx:id="dockClientes" onAction="#irClientes" styleClass="dockbtn" text="🏢 Clientes" />
            <Button fx:id="dockProductos" onAction="#irProductos" styleClass="dockbtn" text="📦 Productos" />
            <Button fx:id="dockProveed" onAction="#irProveedores" styleClass="dockbtn" text="🚚 Proveed." />
         </children>
      </HBox>
   </center>
   <top>
      <HBox fx:id="topbar" alignment="CENTER_RIGHT" prefHeight="26.0" prefWidth="473.0" styleClass="topbar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnMinimizar" text="─" styleClass="wmbtn, wmbtn-min" onAction="#minimizar"/>
            <Button fx:id="btnCerrar"    text="✕" styleClass="wmbtn, wmbtn-close" onAction="#cerrar"/>
         </children></HBox>
   </top>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mx.nanosip.nanosip.Controllers.MainController">

   <center>
      <HBox alignment="CENTER" prefHeight="89.0" prefWidth="473.0" spacing="10">
         <children>
            <Button fx:id="btnRegresar" mnemonicParsing="false" onAction="#VolverLogin" text="Regresar" />
            <Button fx:id="btnEmpleados" mnemonicParsing="false" onAction="#VentanaEmpleados" text="Empleados" />
            <Button fx:id="btnVentas" mnemonicParsing="false" onAction="#VentanaVentas" text="Ventas" />
            <Button fx:id="btnClientes" mnemonicParsing="false" onAction="#VentanaClientes" text="Clientes" />
            <Button fx:id="btnProductos" mnemonicParsing="false" onAction="#VentanaProductos" text="Productos" />
            <Button fx:id="btnProveedores" mnemonicParsing="false" onAction="#VentanaProveedores" text="Proveedores" />
         </children>
      </HBox>
   </center>
   <top>
      <HBox fx:id="topbar" alignment="CENTER_RIGHT" prefHeight="26.0" prefWidth="473.0" styleClass="topbar" BorderPane.alignment="CENTER" />
   </top>

</BorderPane>

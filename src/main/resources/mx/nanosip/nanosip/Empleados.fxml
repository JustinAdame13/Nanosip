<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane
    prefHeight="620.0"
    prefWidth="900.0"
    stylesheets="@Styles.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="mx.nanosip.nanosip.Controllers.EmpleadosController">

    <!-- ═══════════════════════════════════════════
         TOP BAR: acciones principales
    ═══════════════════════════════════════════ -->
    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="8" prefHeight="60.0">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <!-- Título de la sección -->
            <Label text="Empleados" styleClass="topbar-title"/>

            <!-- Espaciador -->
            <HBox HBox.hgrow="ALWAYS"/>

            <!-- Botones de acción -->
            <Button fx:id="btnReporte"   text="📄 Reporte"  styleClass="topbtn, topbtn-report"  onAction="#generarReporte"/>
            <Button fx:id="btnCrear"     text="＋ Crear"    styleClass="topbtn, topbtn-create"   onAction="#crearEmpleado"/>
            <Button fx:id="btnEditar"    text="✎ Editar"   styleClass="topbtn, topbtn-edit"     onAction="#editarEmpleado"/>
            <Button fx:id="btnEliminar"  text="✕ Eliminar" styleClass="topbtn, topbtn-delete"   onAction="#eliminarEmpleado"/>

            <!-- Espaciador -->
            <HBox prefWidth="16"/>

            <!-- Minimizar / Cerrar -->
            <Button fx:id="btnMinimizar" text="─" styleClass="wmbtn, wmbtn-min" onAction="#minimizar"/>
            <Button fx:id="btnCerrar"    text="✕" styleClass="wmbtn, wmbtn-close" onAction="#cerrar"/>
        </HBox>
    </top>

    <!-- ═══════════════════════════════════════════
         CENTER: búsqueda + tabla
    ═══════════════════════════════════════════ -->
    <center>
        <VBox styleClass="content-area" spacing="10">
            <padding><Insets top="14" right="18" bottom="10" left="18"/></padding>

            <!-- Barra de búsqueda -->
            <TextField fx:id="txtBusqueda"
                       promptText="🔍  Buscar empleado…"
                       styleClass="search-field"/>

            <!-- Tabla de empleados -->
            <TableView fx:id="tablaEmpleados"
                       VBox.vgrow="ALWAYS"
                       styleClass="emp-table">
                <columns>
                    <TableColumn fx:id="colId"        text="ID"         prefWidth="60"/>
                    <TableColumn fx:id="colNombre"    text="Nombre"     prefWidth="180"/>
                    <TableColumn fx:id="colApellido"  text="Apellido"   prefWidth="160"/>
                    <TableColumn fx:id="colPuesto"    text="Puesto"     prefWidth="160"/>
                    <TableColumn fx:id="colDept"      text="Depto."     prefWidth="130"/>
                    <TableColumn fx:id="colEstatus"   text="Estatus"    prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ═══════════════════════════════════════════
         BOTTOM: barra de atajos deslizable
         Solo se muestran ~8 px (la "lengüeta") hasta
         que el usuario pasa el cursor encima; entonces
         la barra sube animada mostrando los botones.
         La animación se maneja en EmpleadosController.
    ═══════════════════════════════════════════ -->
    <bottom>
        <!-- Contenedor externo que fija la altura visible -->
        <StackPane fx:id="dockWrapper"
                   prefHeight="8.0"
                   styleClass="dock-wrapper"
                   onMouseEntered="#mostrarDock"
                   onMouseExited="#ocultarDock">

            <!-- Panel deslizable con los botones -->
            <HBox fx:id="dockBar"
                  alignment="CENTER"
                  spacing="12"
                  styleClass="dock-bar"
                  prefHeight="56.0"
                  translateY="48.0">   <!-- empieza casi oculto (56-8 = 48 px abajo) -->
                <padding><Insets top="8" right="20" bottom="8" left="20"/></padding>

                <!-- Botones de navegación rápida -->
                <Button fx:id="dockEmpleados"  text="👤 Empleados"  styleClass="dockbtn, dockbtn-active"   onAction="#irEmpleados"/>
                <Button fx:id="dockVentas"     text="💰 Ventas"     styleClass="dockbtn"                   onAction="#irVentas"/>
                <Button fx:id="dockClientes"   text="🏢 Clientes"   styleClass="dockbtn"                   onAction="#irClientes"/>
                <Button fx:id="dockProductos"  text="📦 Productos"  styleClass="dockbtn"                   onAction="#irProductos"/>
                <Button fx:id="dockProveed"    text="🚚 Proveed."   styleClass="dockbtn"                   onAction="#irProveedores"/>

                <!-- Separador visual -->
                <HBox HBox.hgrow="ALWAYS"/>

                <!-- Cerrar sesión -->
                <Button fx:id="dockSesion"     text="🔒 Sesión"     styleClass="dockbtn, dockbtn-session"  onAction="#cerrarSesion"/>
            </HBox>
        </StackPane>
    </bottom>

</BorderPane>

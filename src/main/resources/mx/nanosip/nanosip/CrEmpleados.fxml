<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="640.0" prefWidth="580.0"
            stylesheets="@Styles.css"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mx.nanosip.nanosip.Controllers.Modals.CrEmpleadosController"
            styleClass="root-pane">

    <!-- TOP BAR -->
    <top>
        <HBox fx:id="topbar" alignment="CENTER_LEFT" prefHeight="46.0" spacing="8" styleClass="topbar">
            <padding><Insets bottom="8" left="16" right="8" top="8"/></padding>
            <Label fx:id="lblTitulo" styleClass="topbar-title" text="Nuevo Empleado"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimizar" styleClass="wmbtn, wmbtn-min" text="─"/>
            <Button onAction="#cerrarModal" styleClass="wmbtn, wmbtn-close" text="✕"/>
        </HBox>
    </top>

    <!-- FORMULARIO -->
    <center>
        <VBox alignment="TOP_LEFT" spacing="12" styleClass="login-card">
            <padding><Insets bottom="28" left="32" right="32" top="20"/></padding>

            <!-- ID (solo lectura) -->
            <VBox spacing="4">
                <Label styleClass="form-label" text="ID"/>
                <TextField fx:id="txtId" promptText="Asignado automáticamente"
                           styleClass="login-field" editable="false" opacity="0.6"/>
            </VBox>

            <!-- Nombre y Puesto -->
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Nombre"/>
                    <TextField fx:id="txtNombre" promptText="Nombre completo"
                               styleClass="login-field"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Puesto"/>
                    <TextField fx:id="txtPuesto" promptText="Puesto"
                               styleClass="login-field"/>
                </VBox>
            </HBox>

            <!-- RFC y CURP -->
            <HBox spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="RFC"/>
                    <TextField fx:id="txtRFC" promptText="RFC"
                               styleClass="login-field"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="CURP"/>
                    <TextField fx:id="txtCURP" promptText="CURP"
                               styleClass="login-field"/>
                </VBox>
            </HBox>

            <!-- Edad, Contraseña y Confirmación -->
            <HBox spacing="12">
                <VBox spacing="4">
                    <Label styleClass="form-label" text="Edad"/>
                    <Spinner fx:id="spnEdad" min="18" max="99"
                             initialValue="18" editable="true"
                             prefWidth="100" styleClass="modal-spinner"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Contraseña"/>
                    <PasswordField fx:id="txtPassword" promptText="Contraseña"
                                   styleClass="login-field"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="form-label" text="Confirmar contraseña"/>
                    <PasswordField fx:id="txtPasswordConfirm" promptText="Repetir contraseña"
                                   styleClass="login-field"/>
                    <!-- Mensaje de error, oculto por defecto -->
                    <Label fx:id="lblPasswordError" styleClass="field-error"
                           text="Las contraseñas no coinciden" visible="false" managed="false"/>
                </VBox>
            </HBox>

            <!-- ── Permisos ── -->
            <VBox spacing="8">
                <Label styleClass="form-section-label" text="Permisos de acceso"/>

                <GridPane hgap="6" vgap="6" styleClass="permisos-grid">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="110" minWidth="110"/>
                        <ColumnConstraints prefWidth="80" halignment="CENTER"/>
                        <ColumnConstraints prefWidth="80" halignment="CENTER"/>
                        <ColumnConstraints prefWidth="80" halignment="CENTER"/>
                        <ColumnConstraints prefWidth="80" halignment="CENTER"/>
                    </columnConstraints>

                    <!-- Encabezados -->
                    <Label text="Módulo"   styleClass="perm-header" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <Label text="Ver"      styleClass="perm-header" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                    <Label text="Crear"    styleClass="perm-header" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <Label text="Editar"   styleClass="perm-header" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                    <Label text="Eliminar" styleClass="perm-header" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                    <!-- Empleados -->
                    <Label text="👤 Empleados" styleClass="perm-module" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="tEmpVer"      styleClass="perm-toggle" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="tEmpCrear"    styleClass="perm-toggle" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="tEmpEditar"   styleClass="perm-toggle" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                    <ToggleButton fx:id="tEmpEliminar" styleClass="perm-toggle" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                    <!-- Ventas -->
                    <Label text="💰 Ventas"    styleClass="perm-module" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <ToggleButton fx:id="tVenVer"      styleClass="perm-toggle" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                    <ToggleButton fx:id="tVenCrear"    styleClass="perm-toggle" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                    <ToggleButton fx:id="tVenEditar"   styleClass="perm-toggle" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                    <ToggleButton fx:id="tVenEliminar" styleClass="perm-toggle" GridPane.columnIndex="4" GridPane.rowIndex="2"/>

                    <!-- Clientes -->
                    <Label text="🏢 Clientes"  styleClass="perm-module" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                    <ToggleButton fx:id="tCliVer"      styleClass="perm-toggle" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    <ToggleButton fx:id="tCliCrear"    styleClass="perm-toggle" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                    <ToggleButton fx:id="tCliEditar"   styleClass="perm-toggle" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                    <ToggleButton fx:id="tCliEliminar" styleClass="perm-toggle" GridPane.columnIndex="4" GridPane.rowIndex="3"/>

                    <!-- Productos -->
                    <Label text="📦 Productos" styleClass="perm-module" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                    <ToggleButton fx:id="tProVer"      styleClass="perm-toggle" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                    <ToggleButton fx:id="tProCrear"    styleClass="perm-toggle" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                    <ToggleButton fx:id="tProEditar"   styleClass="perm-toggle" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                    <ToggleButton fx:id="tProEliminar" styleClass="perm-toggle" GridPane.columnIndex="4" GridPane.rowIndex="4"/>

                    <!-- Proveedores -->
                    <Label text="🚚 Proveed."  styleClass="perm-module" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                    <ToggleButton fx:id="tPrvVer"      styleClass="perm-toggle" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
                    <ToggleButton fx:id="tPrvCrear"    styleClass="perm-toggle" GridPane.columnIndex="2" GridPane.rowIndex="5"/>
                    <ToggleButton fx:id="tPrvEditar"   styleClass="perm-toggle" GridPane.columnIndex="3" GridPane.rowIndex="5"/>
                    <ToggleButton fx:id="tPrvEliminar" styleClass="perm-toggle" GridPane.columnIndex="4" GridPane.rowIndex="5"/>
                </GridPane>
            </VBox>

            <Region VBox.vgrow="ALWAYS" minHeight="10"/>

            <!-- Botón guardar -->
            <Button fx:id="btnGuardar" onAction="#guardar"
                    text="Guardar" styleClass="login-btn"
                    maxWidth="Infinity"/>
        </VBox>
    </center>

</BorderPane>
